<UserControl x:Class = "Arcanum.UI.Components.UserControls.ValueAllocators.MassPopPainterView"
             xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc = "http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
             xmlns:acb = "clr-namespace:Arcanum.UI.Components.UserControls.BaseControls.AutoCompleteBox"
             xmlns:g = "clr-namespace:Arcanum.Core.GlobalStates;assembly=Arcanum.Core"
             xmlns:valueAllocators = "clr-namespace:Arcanum.UI.Components.UserControls.ValueAllocators"
             xmlns:converters = "clr-namespace:Arcanum.UI.Components.Converters"
             xmlns:baseControls = "clr-namespace:Arcanum.UI.Components.UserControls.BaseControls"
             xmlns:styleClasses = "clr-namespace:Arcanum.UI.Components.StyleClasses" mc:Ignorable = "d"
             d:DesignHeight = "500" d:DesignWidth = "400"
             d:DataContext = "{d:DesignInstance valueAllocators:MassPopPainterViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source = "/Arcanum_UI;component/Components/Styles/Base/BaseTextBoxStyle.xaml" />
                <ResourceDictionary Source = "/Arcanum_UI;component/Components/Styles/Base/BaseButton.xaml" />
                <ResourceDictionary Source = "/Arcanum_UI;component/Components/Styles/Base/BlueTollgeButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToOpacityConverter x:Key = "BoolToOpacityConverter" TrueValue = "1" FalseValue = "0.5" />

            <Style x:Key = "SlimSliderThumbStyle" TargetType = "Thumb">
                <Setter Property = "OverridesDefaultStyle" Value = "true" />
                <Setter Property = "Cursor" Value = "Hand" />
                <Setter Property = "Template">
                    <Setter.Value>
                        <ControlTemplate TargetType = "Thumb">
                            <Grid Background = "Transparent">
                                <!-- 
                                   THE INVISIBLE GRIP (Hit Box):
                                   We make this wider than the visual thumb (e.g. 24px).
                                   We use Negative Margins to center it over the 6px root.
                                   Background="Transparent" captures the mouse clicks.
                                -->
                                <Border Width = "24" Height = "24" Margin = "-9,0,-9,0" Background = "Transparent" />

                                <!-- THE VISUAL HANDLE -->
                                <Border x:Name = "VisualThumb" Background = "#E0E0E0" BorderBrush = "#111"
                                        BorderThickness = "1" CornerRadius = "3" Width = "6" Height = "14"
                                        VerticalAlignment = "Center" HorizontalAlignment = "Center" />
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property = "IsMouseOver" Value = "True">
                                    <Setter TargetName = "VisualThumb" Property = "Background" Value = "White" />
                                </Trigger>
                                <Trigger Property = "IsDragging" Value = "True">
                                    <Setter TargetName = "VisualThumb" Property = "Background" Value = "White" />
                                    <Setter TargetName = "VisualThumb" Property = "BorderBrush" Value = "#666" />
                                </Trigger>
                                <Trigger Property = "IsEnabled" Value = "False">
                                    <Setter TargetName = "VisualThumb" Property = "Background" Value = "#555" />
                                    <Setter TargetName = "VisualThumb" Property = "BorderBrush" Value = "#333" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key = "SliderRepeatButtonStyle" TargetType = "RepeatButton">
                <Setter Property = "OverridesDefaultStyle" Value = "true" />
                <Setter Property = "IsTabStop" Value = "false" />
                <Setter Property = "Focusable" Value = "false" />
                <Setter Property = "Template">
                    <Setter.Value>
                        <ControlTemplate TargetType = "RepeatButton">
                            <Border Background = "{TemplateBinding Background}" Height = "4" CornerRadius = "2" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key = "SlimColorSliderStyle" TargetType = "Slider">
                <Setter Property = "OverridesDefaultStyle" Value = "true" />
                <Setter Property = "Focusable" Value = "False" /> <!-- Prevents dotted focus rect -->
                <Setter Property = "Template">
                    <Setter.Value>
                        <ControlTemplate TargetType = "Slider">
                            <Grid>
                                <!-- Background Rail (Dark Grey) -->
                                <Border x:Name = "TrackBackground" Background = "#333333" Height = "4"
                                        CornerRadius = "2" VerticalAlignment = "Center" />

                                <!-- The Track logic -->
                                <Track x:Name = "PART_Track">

                                    <!-- Left Side (Filled) -->
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style = "{StaticResource SliderRepeatButtonStyle}"
                                                      Background = "{TemplateBinding Foreground}" />
                                    </Track.DecreaseRepeatButton>

                                    <!-- The Thumb -->
                                    <Track.Thumb>
                                        <Thumb Style = "{StaticResource SlimSliderThumbStyle}" />
                                    </Track.Thumb>

                                    <!-- Right Side (Unfilled) -->
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style = "{StaticResource SliderRepeatButtonStyle}"
                                                      Background = "Transparent" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Dim the filled track when disabled/locked -->
                                <Trigger Property = "IsEnabled" Value = "False">
                                    <Setter Property = "Foreground" Value = "#555" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility = "Auto">
        <StackPanel Margin = "10">
            <TextBlock Text = "Mass Pop Painter" Foreground = "{StaticResource GreenColorBrush}" FontWeight = "Bold"
                       HorizontalAlignment = "Center" FontSize = "14" Margin = "0,0,0,10" />

            <!-- Preview Info Box -->
            <Border CornerRadius = "4" Padding = "8" Margin = "0,0,0,10">
                <StackPanel Orientation = "Horizontal" HorizontalAlignment = "Center">
                    <TextBlock Text = "Affecting " Opacity = "0.6" FontSize = "11" />
                    <TextBlock Text = "{Binding AffectedPopsCount}" FontWeight = "Bold"
                               Foreground = "{StaticResource GreenColorBrush}" FontSize = "11" />
                    <TextBlock Text = " pops in " Opacity = "0.6" FontSize = "11" />
                    <TextBlock Text = "{Binding AffectedLocationsCount}" FontWeight = "Bold"
                               Foreground = "{StaticResource BlueAccentColorBrush}" FontSize = "11" />
                    <TextBlock Text = " locations" Opacity = "0.6" FontSize = "11" />
                </StackPanel>
            </Border>

            <!-- 1. CULTURE BLOCK -->
            <Border Background = "{StaticResource DarkBackColorBrush}" CornerRadius = "5" Margin = "0,2" Padding = "10"
                    BorderThickness = "1" BorderBrush = "{StaticResource LightBackColorBrush}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text = "CULTURE" FontWeight = "SemiBold" FontSize = "11"
                                   Foreground = "{StaticResource BlueAccentColorBrush}" VerticalAlignment = "Center"
                                   Opacity = "{Binding ModifyCulture, Converter={StaticResource BoolToOpacityConverter}}" />
                        <ToggleButton Style = "{StaticResource BlueToggleButtonStyle}" HorizontalAlignment = "Right"
                                      IsChecked = "{Binding ModifyCulture}" Content = "Enable" Width = "60"
                                      Height = "20" FontSize = "9" Margin = "0, 0, 0, 2" />
                    </Grid>

                    <Grid IsEnabled = "{Binding ModifyCulture}"
                          Opacity = "{Binding ModifyCulture, Converter={StaticResource BoolToOpacityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width = "80" />
                            <ColumnDefinition Width = "*" />
                            <ColumnDefinition Width = "24" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height = "Auto" />
                            <RowDefinition Height = "Auto" />
                        </Grid.RowDefinitions>

                        <!-- Filter Row -->
                        <TextBlock Grid.Column = "0" Text = "Filter by:" VerticalAlignment = "Center" FontSize = "10"
                                   Margin = "5,0,0,0" />
                        <acb:AutoCompleteComboBox x:Name = "CultureFilterBox" Grid.Row = "0" Grid.Column = "1"
                                                  Height = "22" Margin = "0,0,2,2"
                                                  FullItemsSource = "{Binding AvailableCultures}"
                                                  SelectedItem = "{Binding SourceCulture, Mode=TwoWay}"
                                                  SelectionChanged = "Selector_OnSelectionChanged" />
                        <styleClasses:BaseButton Grid.Row = "0" Grid.Column = "2" Content = "✕"
                                                 Click = "ClearCultureFilter_OnClick" FontSize = "10" Height = "22"
                                                 Width = "22" Margin = "0,0,0,2" />

                        <!-- Target Row -->
                        <TextBlock Grid.Column = "0" Grid.Row = "1" Text = "Change to:" VerticalAlignment = "Center"
                                   FontSize = "10" Margin = "5,0,0,0" />
                        <acb:AutoCompleteComboBox x:Name = "CultureTargetBox" Grid.Row = "1" Grid.Column = "1"
                                                  Height = "22" Margin = "0,2,2,0"
                                                  FullItemsSource = "{Binding Source={x:Static g:Globals.Cultures}, Path=Values}"
                                                  SelectedItem = "{Binding TargetCulture, Mode=TwoWay}" />
                        <styleClasses:BaseButton Grid.Row = "1" Grid.Column = "2" Content = "✕"
                                                 Click = "ClearCultureTarget_OnClick" FontSize = "10" Height = "22"
                                                 Width = "22" Margin = "0,2,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. RELIGION BLOCK (Identical Structure) -->
            <Border Background = "{StaticResource DarkBackColorBrush}" CornerRadius = "5" Margin = "0,2" Padding = "10"
                    BorderThickness = "1" BorderBrush = "{StaticResource LightBackColorBrush}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text = "RELIGION" FontWeight = "SemiBold" FontSize = "11" Foreground = "#FFD700"
                                   VerticalAlignment = "Center"
                                   Opacity = "{Binding ModifyReligion, Converter={StaticResource BoolToOpacityConverter}}" />
                        <ToggleButton Style = "{StaticResource BlueToggleButtonStyle}" HorizontalAlignment = "Right"
                                      IsChecked = "{Binding ModifyReligion}" Content = "Enable" Width = "60"
                                      Height = "20" FontSize = "9" Margin = "0, 0, 0, 2" />
                    </Grid>
                    <Grid IsEnabled = "{Binding ModifyReligion}"
                          Opacity = "{Binding ModifyReligion, Converter={StaticResource BoolToOpacityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width = "80" />
                            <ColumnDefinition Width = "*" />
                            <ColumnDefinition Width = "24" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column = "0" Text = "Filter by:" VerticalAlignment = "Center" FontSize = "10"
                                   Margin = "5,0,0,0" />
                        <acb:AutoCompleteComboBox x:Name = "ReligionFilterBox" Grid.Row = "0" Grid.Column = "1"
                                                  Height = "22" Margin = "0,0,2,2"
                                                  FullItemsSource = "{Binding AvailableReligions}"
                                                  SelectedItem = "{Binding SourceReligion, Mode=TwoWay}"
                                                  SelectionChanged = "Selector_OnSelectionChanged" />
                        <styleClasses:BaseButton Grid.Row = "0" Grid.Column = "2" Content = "✕"
                                                 Click = "ClearReligionFilter_OnClick" FontSize = "10" Height = "22"
                                                 Width = "22" Margin = "0,0,0,2" />

                        <TextBlock Grid.Column = "0" Grid.Row = "1" Text = "Change to:" VerticalAlignment = "Center"
                                   FontSize = "10" Margin = "5,0,0,0" />
                        <acb:AutoCompleteComboBox x:Name = "ReligionTargetBox" Grid.Row = "1" Grid.Column = "1"
                                                  Height = "22" Margin = "0,2,2,0"
                                                  FullItemsSource = "{Binding Source={x:Static g:Globals.Religions}, Path=Values}"
                                                  SelectedItem = "{Binding TargetReligion, Mode=TwoWay}" />
                        <styleClasses:BaseButton Grid.Row = "1" Grid.Column = "2" Content = "✕"
                                                 Click = "ClearReligionTarget_OnClick" FontSize = "10" Height = "22"
                                                 Width = "22" Margin = "0,2,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. POP TYPE BLOCK (Identical Structure) -->
            <Border Background = "{StaticResource DarkBackColorBrush}" CornerRadius = "5" Margin = "0,2" Padding = "10"
                    BorderThickness = "1" BorderBrush = "{StaticResource LightBackColorBrush}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text = "POP TYPE" FontWeight = "SemiBold" FontSize = "11" Foreground = "#E06666"
                                   VerticalAlignment = "Center"
                                   Opacity = "{Binding ModifyPopType, Converter={StaticResource BoolToOpacityConverter}}" />
                        <ToggleButton Style = "{StaticResource BlueToggleButtonStyle}" HorizontalAlignment = "Right"
                                      IsChecked = "{Binding ModifyPopType}" Content = "Enable" Width = "60"
                                      Height = "20" FontSize = "9" Margin = "0, 0, 0, 2" />
                    </Grid>
                    <Grid IsEnabled = "{Binding ModifyPopType}"
                          Opacity = "{Binding ModifyPopType, Converter={StaticResource BoolToOpacityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width = "80" />
                            <ColumnDefinition Width = "*" />
                            <ColumnDefinition Width = "24" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column = "0" Text = "Filter by:" VerticalAlignment = "Center" FontSize = "10"
                                   Margin = "5,0,0,0" />
                        <acb:AutoCompleteComboBox x:Name = "PopTypeFilterBox" Grid.Row = "0" Grid.Column = "1"
                                                  Height = "22" Margin = "0,0,2,2"
                                                  FullItemsSource = "{Binding AvailablePopTypes}"
                                                  SelectedItem = "{Binding SourcePopType, Mode=TwoWay}"
                                                  SelectionChanged = "Selector_OnSelectionChanged" />
                        <styleClasses:BaseButton Grid.Row = "0" Grid.Column = "2" Content = "✕"
                                                 Click = "ClearPopTypeFilter_OnClick" FontSize = "10" Height = "22"
                                                 Width = "22" Margin = "0,0,0,2" />

                        <TextBlock Grid.Column = "0" Grid.Row = "1" Text = "Change to:" VerticalAlignment = "Center"
                                   FontSize = "10" Margin = "5,0,0,0" />
                        <acb:AutoCompleteComboBox x:Name = "PopTypeTargetBox" Grid.Row = "1" Grid.Column = "1"
                                                  Height = "22" Margin = "0,2,2,0"
                                                  FullItemsSource = "{Binding Source={x:Static g:Globals.PopTypes}, Path=Values}"
                                                  SelectedItem = "{Binding TargetPopType, Mode=TwoWay}" />
                        <styleClasses:BaseButton Grid.Row = "1" Grid.Column = "2" Content = "✕"
                                                 Click = "ClearPopTypeTarget_OnClick" FontSize = "10" Height = "22"
                                                 Width = "22" Margin = "0,2,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <CheckBox IsChecked = "{Binding UseTotalRatioMode}" HorizontalAlignment = "Center" Margin = "0,5,0,0"
                      ToolTip = "If checked, all filtered pops will be combined into a single entry with the target identity.">
                <TextBlock Text = "Pool results into single pop identity" FontSize = "10" Opacity = "0.8" />
            </CheckBox>
            
            <!-- GLOBAL SLIDER -->
            <StackPanel Margin = "0,15,0,0">
                <Grid Margin = "0,0,0,-5">
                    <TextBlock Text = "Global Transfer %" FontSize = "10" Opacity = "0.5" VerticalAlignment = "Bottom" />
                    <!-- Added NumericUpDown for precision typing -->
                    <baseControls:DecimalBaseNumericUpDown HorizontalAlignment = "Right" Width = "60" Height = "20"
                                                           Value = "{Binding GlobalTransferPercent}" FontSize = "11"
                                                           FontWeight = "Bold" />
                </Grid>
                <Slider Value = "{Binding GlobalTransferPercent}" Minimum = "0" Maximum = "100"
                        Style = "{StaticResource SlimColorSliderStyle}" Foreground = "{StaticResource GreenColorBrush}" />
            </StackPanel>

            <TextBlock Text = "Only enabled sections will filter or modify populations." FontSize = "9" Opacity = "0.4"
                       HorizontalAlignment = "Center" Margin = "0,10" />
        </StackPanel>
    </ScrollViewer>
</UserControl>