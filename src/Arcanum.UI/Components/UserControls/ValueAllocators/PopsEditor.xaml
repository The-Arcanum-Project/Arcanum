<UserControl x:Name = "Root" x:Class = "Arcanum.UI.Components.UserControls.ValueAllocators.PopsEditor"
             xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc = "http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local = "clr-namespace:Arcanum.UI.Components.UserControls.ValueAllocators"
             xmlns:converters = "clr-namespace:Arcanum.UI.Components.Converters"
             xmlns:styleClasses = "clr-namespace:Arcanum.UI.Components.StyleClasses"
             xmlns:charts = "clr-namespace:Arcanum.UI.Components.Charts.DonutChart"
             xmlns:baseControls = "clr-namespace:Arcanum.UI.Components.UserControls.BaseControls" mc:Ignorable = "d"
             d:DesignHeight = "800" d:DesignWidth = "600" d:DataContext = "{d:DesignInstance local:PopEditorVm}">

    <UserControl.InputBindings>
        <!-- Alt+Z Undo -->
        <KeyBinding Modifiers = "Alt" Key = "Z" Command = "{Binding UndoCommand}" />
        <!-- Apply changes via Ctrl+S. Bind to the UserControl.DataContext explicitly because InputBindings do not inherit DataContext reliably -->
        <KeyBinding Modifiers = "Control" Key = "Q"
                    Command = "{Binding DataContext.ApplyChangesCommand, ElementName=Root}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source = "/Arcanum_UI;component/Components/Styles/Base/BaseTextBoxStyle.xaml" />
                <ResourceDictionary Source = "/Arcanum_UI;component/Components/Styles/Base/BaseButton.xaml" />
                <ResourceDictionary Source = "/Arcanum_UI;component/Components/Styles/Base/BlueTollgeButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key = "ThinBaseButtonStyle" TargetType = "styleClasses:BaseButton"
                   BasedOn = "{StaticResource {x:Type styleClasses:BaseButton}}">
                <Setter Property = "Background" Value = "Transparent" />
                <Setter Property = "FontWeight" Value = "Bold" />
                <Setter Property = "Cursor" Value = "Hand" />
                <Setter Property = "Width" Value = "20" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility = "Disabled" VerticalScrollBarVisibility = "Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height = "Auto" />
                <RowDefinition Height = "Auto" MaxHeight = "800" />
                <RowDefinition Height = "Auto" />
                <RowDefinition Height = "Auto" />
                <RowDefinition Height = "*" />
            </Grid.RowDefinitions>

            <!-- Location Name Title Bar -->
            <TextBlock Grid.Row = "0" Text = "{Binding Title, FallbackValue='Select a Location...'}" Margin = "0,0,0,3"
                       FontSize = "16" FontWeight = "Bold" VerticalAlignment = "Center" HorizontalAlignment = "Center" />


            <ContentControl Grid.Row = "1" Content = "{Binding ActiveEditor}">
                <ContentControl.Resources>
                    <!-- Template for Single Selection -->
                    <DataTemplate DataType = "{x:Type local:AllocatorViewModel}">
                        <local:SingleLocationView />
                    </DataTemplate>

                    <!-- Template for Multiple Selection (The Painter) -->
                    <DataTemplate DataType = "{x:Type local:MassPopPainterViewModel}">
                        <local:MassPopPainterView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>


            <!-- Apply Changes Button -->
            <styleClasses:BaseButton Grid.Row = "2" Content = "Apply Changes" Command = "{Binding ApplyChangesCommand}"
                                     HorizontalAlignment = "Center" Margin = "0,10,0,10" Height = "25"
                                     VerticalAlignment = "Center" Background = "{StaticResource GreenColorBrush}"
                                     local:InteractionMonitor.AllocatorVm = "{Binding}"
                                     Style = "{StaticResource ThinBaseButtonStyle}" Width = "200"
                                     ToolTip = "Apply Changes (Ctrl+Q)" />

            <Grid Grid.Row = "3">
                <Grid.RowDefinitions>
                    <RowDefinition Height = "Auto" />
                    <RowDefinition Height = "Auto" />
                    <RowDefinition Height = "Auto" />
                    <RowDefinition Height = "Auto" />
                    <RowDefinition Height = "Auto" />
                </Grid.RowDefinitions>

                <!-- Separator Line -->
                <Rectangle Grid.Row = "0" Grid.ColumnSpan = "2" Height = "1"
                           Fill = "{StaticResource DefaultBorderColorBrush}" Margin = "0,2,0,10" />

                <DockPanel Grid.Row = "1" LastChildFill = "False" Margin = "0, 0, 0, 3">
                    <TextBlock DockPanel.Dock = "Left" Text = "Paste from location:" HorizontalAlignment = "Left"
                               VerticalAlignment = "Center" />

                    <styleClasses:BaseButton DockPanel.Dock = "Left" Content = "📋" Width = "91" Height = "24"
                                             Command = "{Binding PasteFromLocationCommand}"
                                             HorizontalAlignment = "Right" Margin = "15,0,0,0"
                                             local:InteractionMonitor.AllocatorVm = "{Binding}"
                                             Style = "{StaticResource ThinBaseButtonStyle}"
                                             ToolTip = "Fetch Pop composition from another location and append it here." />
                </DockPanel>

                <DockPanel Grid.Row = "2" LastChildFill = "False" Margin = "0, 0, 0, 3">
                    <TextBlock Text = "Paste with Variation:" VerticalAlignment = "Center" HorizontalAlignment = "Left"
                               Margin = "0,0,5,0" />

                    <styleClasses:BaseButton DockPanel.Dock = "Left" Content = "📋" Width = "91" Height = "24"
                                             Command = "{Binding PasteFromLocationVariationCommand}"
                                             HorizontalAlignment = "Left" Margin = "9,0,0,0"
                                             local:InteractionMonitor.AllocatorVm = "{Binding}"
                                             Style = "{StaticResource ThinBaseButtonStyle}"
                                             ToolTip = "Fetch Pop composition from another location and append it here." />
                </DockPanel>

                <DockPanel Grid.Row = "3" LastChildFill = "False" Margin = "0, 0, 0, 3">

                    <!-- Min Variation / Max Variation Inputs -->
                    <TextBlock Text = "Min Variation:" VerticalAlignment = "Center" HorizontalAlignment = "Right"
                               Margin = "0,0,5,0" />
                    <baseControls:FloatNumericUpDown MinValue = "0" MaxValue = "1000"
                                                     ToolTip = "The minimum random offset applied to the size of each pasted Pop, in percent. For example, a value of 10 means each Pop will have a random offset between -10% and +10% of its size."
                                                     Value = "{Binding PasteVariationMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment = "Left" Margin = "5,0,15,0" Width = "60" />
                    <TextBlock Text = "Max Variation:" VerticalAlignment = "Center" HorizontalAlignment = "Right"
                               Margin = "0,0,5,0" />
                    <baseControls:FloatNumericUpDown MinValue = "0" MaxValue = "1000"
                                                     ToolTip = "The maximum random offset applied to the size of each pasted Pop, in percent. For example, a value of 10 means each Pop will have a random offset between -10% and +10% of its size."
                                                     Value = "{Binding PasteVariationMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment = "Left" Margin = "5,0,0,0" Width = "60" />
                </DockPanel>
                <DockPanel Grid.Row = "4" LastChildFill = "False" Margin = "0, 0, 0, 3">
                    <CheckBox DockPanel.Dock = "Left" VerticalAlignment = "Center" Margin = "5, 0, 5, 0"
                              Content = "Paste in all selected Locations"
                              IsChecked = "{Binding PasteInEntireSelection}" />

                    <CheckBox DockPanel.Dock = "Left" VerticalAlignment = "Center" Margin = "5, 0, 5, 0"
                              Content = "Replace all existing pops" IsChecked = "{Binding ReplaceExistingPops}" />
                </DockPanel>

            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>